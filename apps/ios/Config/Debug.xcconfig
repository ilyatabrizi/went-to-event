// Local development configuration.
// Simulator requests stay on the Mac; physical-device requests use the Mac's
// current hotspot/LAN address. Update only this line when the network changes.
WTE_API_BASE_URL = http:/$()/127.0.0.1:3000
WTE_API_BASE_URL[sdk=iphoneos*] = http:/$()/192.168.100.57:3000
