# The API uses the in-memory repository when these are absent.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
CLERK_SECRET_KEY=replace-me

# Optional email notifications for new venue/business inquiries (Resend).
RESEND_API_KEY=replace-me
BUSINESS_LEADS_TO_EMAIL=ads@wenttoevent.com
BUSINESS_LEADS_FROM_EMAIL=leads@wenttoevent.com

# Comma-separated Clerk user IDs allowed to approve or reject verification requests.
ADMIN_CLERK_USER_IDS=user_123,user_456

# Optional API server settings
WEB_ORIGINS=https://wenttoevent.com,https://www.wenttoevent.com
# Bind to all interfaces so a physical iPhone on the same network can reach the API.
HOST=0.0.0.0
PORT=3000
