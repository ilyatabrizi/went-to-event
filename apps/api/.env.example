# The API uses the in-memory repository when these are absent.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
QR_TICKET_SECRET=replace-with-a-long-random-secret

# Optional transactional email notifications (Resend).
RESEND_API_KEY=replace-me
RESEND_FROM_EMAIL=info@wenttoevent.com
INFO_FROM_EMAIL=info@wenttoevent.com
BUSINESS_LEADS_TO_EMAIL=ads@wenttoevent.com
BUSINESS_LEADS_FROM_EMAIL=info@wenttoevent.com

# Comma-separated Supabase Auth user UUIDs allowed to approve or reject verification requests.
ADMIN_AUTH_USER_IDS=user_uuid_1,user_uuid_2

# Optional API server settings
WEB_ORIGINS=https://wenttoevent.com,https://www.wenttoevent.com
# Bind to all interfaces so a physical iPhone on the same network can reach the API.
HOST=0.0.0.0
PORT=3000

# Web Push notifications for installed web-app users.
WEB_PUSH_SUBJECT=mailto:info@wenttoevent.com
VAPID_PUBLIC_KEY=replace-me
VAPID_PRIVATE_KEY=replace-me
